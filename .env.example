# Postgres credentials. docker-compose builds DATABASE_URL from these for
# the migrate, app, and seed services; running any Go binary directly
# instead of through docker compose requires setting DATABASE_URL yourself,
# e.g. postgres://postgres:postgres@localhost:5432/product_rag?sslmode=disable
POSTGRES_DB=product_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Gemini API key (internal/embeddings/gemini, internal/llm/gemini). Get one
# at ai.google.dev; the free tier covers this project's usage.
GEMINI_API_KEY=AIza...
# Model for intent classification (internal/intent). A cheap, fast model is
# enough here: it returns one JSON object per query.
GEMINI_INTENT_MODEL=gemini-3.5-flash-lite
# Model for answer generation (internal/llm/gemini). This is the strongest
# model in the pipeline, since it writes the text the user reads.
GEMINI_ANSWER_MODEL=gemini-3.8-flash
# Model for product and query embeddings (internal/embeddings/gemini).
# The embedding vector length is not configurable here: it is fixed at 1536
# by gemini.EmbeddingDimension, matching the `vector(1536)` column in
# migrations/0001_init_products.up.sql.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Address the HTTP server binds to (cmd/server).
HTTP_ADDR=:8080
# Minimum level the server logs, passed to the slog JSON handler in
# cmd/server/main.go: debug, info, warn, or error.
LOG_LEVEL=info
# k in the Reciprocal Rank Fusion formula, score = sum(1 / (k + rank)),
# applied per retrieval signal (internal/rerank/rrf). A larger k shrinks the
# score gap between a top-ranked and a lower-ranked candidate, so ranks
# further down the list still add up to a meaningful score.
RRF_K=60
# Candidates each retrieval source (vector, fulltext, graph) returns before
# fusion (internal/pipeline). Raising this widens what RRF has to fuse, at
# the cost of more work per query.
RETRIEVAL_TOP_K=10
# Products returned to the caller after fusion and reranking. This is a
# subset of RETRIEVAL_TOP_K, not a separate fetch.
FINAL_TOP_N=5
# Bearer token required on POST /ingest (internal/router). The only access
# control on that endpoint: set a real secret before exposing the service
# past localhost.
ADMIN_TOKEN=changeme
